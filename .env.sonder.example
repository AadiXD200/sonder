# Copy to .env.sonder and fill in. Sourced by scripts/site.sh.
#
#   cp .env.sonder.example .env.sonder

# GoatCounter subdomain -- the part before .goatcounter.com in the dashboard
# URL. Unset or empty ships the site with no tracking at all, which is the
# right default for local builds and previews.
SONDER_GC_SITE=
