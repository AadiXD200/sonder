# ── secrets ─────────────────────────────────────────────
# .env holds live API keys. Never commit it.
.env
.env.*
!.env.example
*.key
*.pem

# ── node / next ─────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── python (scraper) ────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── scraper cache / intermediates ───────────────────────
# ~100 MB of registrar scrape intermediates, rebuilt by scripts/build.py.
# Written as "everything inside .cache" rather than ".cache/" because git
# will not look inside an excluded directory, so a later negation for one
# file in it can never match. The directory has to stay searchable.
.cache/*
scrape_cache/
*.raw.json

# ...with one exception. tags.json is the output of the LLM tagging pass:
# it costs real money and ~40 minutes of API calls to regenerate, and a
# fresh clone without it would silently fall back to deterministic-only
# tags, quietly losing every model correction. It is 100 KB. Commit it.
!.cache/tags.json

# ── build output ────────────────────────────────────────
# site/ is assembled by scripts/site.sh and rebuilt by the host on deploy.
# data/lectures.json is the raw archive, regenerated by the same script.
site/
data/

# ── screenshots / scratch ───────────────────────────────
# design exploration captures, not part of the app. None are referenced by
# landing/ or preview/src -- they are screenshots from building the thing.
b*.png
m*.png
hero*.png
*.jpg
.playwright-mcp/

# ── os / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/

# Landing-page design explorations. Kept on disk as reference, not shipped
# (scripts/site.sh strips alts/ from the build anyway) and not committed --
# the chosen page is landing/index.html.
landing/alts/
